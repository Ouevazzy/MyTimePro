    "entryCheck.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste ist eine Hilfe und garantiert nicht die Einhaltung des Gesetzes. Die Arbeitszeiterfassung obliegt dem Arbeitgeber. Eine Pause kann als Arbeit gelten, wenn Sie den Arbeitsplatz nicht verlassen dürfen."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste ist eine Hilfe und garantiert nicht die Einhaltung des Gesetzes. Die Arbeitszeiterfassung obliegt dem Arbeitgeber. Eine Pause kann als Arbeit gelten, wenn Sie den Arbeitsplatz nicht verlassen dürfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This list is an aid: it does not guarantee legal compliance. Recording working time is the employer's duty. A break may count as work if you cannot leave your workplace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste est une aide : elle ne garantit pas le respect de la loi. L'enregistrement du temps de travail incombe à l'employeur. Une pause peut compter comme travail si vous ne pouvez pas quitter votre place."
          }
        }
      }
    },
    "entryCheck.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu prüfen"
          }
        },
        "de-CH" : {

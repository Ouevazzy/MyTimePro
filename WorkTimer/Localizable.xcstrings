    "entryCheck.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf einen Tag, um ihn zu ergänzen, wischen Sie, um ihn zu ignorieren. Geprüft werden die letzten %lld Tage, außer heute, Abwesenheiten, arbeitsfreie Tage und Feiertage des gewählten Kantons."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf einen Tag, um ihn zu ergänzen, wischen Sie, um ihn zu ignorieren. Geprüft werden die letzten %lld Tage, ausser heute, Absenzen, arbeitsfreie Tage und Feiertage des gewählten Kantons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a day to complete it, swipe to ignore it. The last %lld days are checked, except today, absences, days off, and the holidays of the selected canton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jour pour le compléter, balayez-le pour l'ignorer. Les %lld derniers jours sont examinés, sauf aujourd'hui, les absences, les jours non travaillés et les jours fériés du canton choisi."
          }
        }
      }
    },

    "diagnostics.recalculate.confirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Arbeitsstunden und Überstunden aller Einträge aus %@ mit Ihren aktuellen Einstellungen neu berechnet.\n\nDies kann nicht rückgängig gemacht werden."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Arbeitsstunden und Überstunden aller Einträge aus %@ mit Ihren aktuellen Einstellungen neu berechnet.\n\nDies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will recalculate worked hours and overtime for all entries in %@ using your current settings.\n\nThis cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action va recalculer les heures travaillées et supplémentaires de toutes les entrées de %@ en fonction de vos paramètres actuels.\n\nCette action est irréversible."
          }
        }
      }
    },

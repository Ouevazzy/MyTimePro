    "paywall.legal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Abonnements verwalten: Einstellungen > [Ihr Name] > Abonnements."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Abonnements verwalten: Einstellungen > [Ihr Name] > Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscription automatically renews unless cancelled at least 24 hours before the end of the current period. Manage your subscriptions in Settings > [Your name] > Subscriptions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement se renouvelle automatiquement sauf résiliation au moins 24h avant la fin de la période en cours. Gérez vos abonnements dans Réglages > [Votre nom] > Abonnements."
          }
        }
      }
    },

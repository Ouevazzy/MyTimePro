            "state" : "translated",
            "value" : "Im Debug-Modus ist CloudKit deaktiviert. TestFlight und der App Store verwenden die Produktionsumgebung: Das CloudKit-Schema muss dort über das Dashboard bereitgestellt werden, damit die Synchronisierung funktioniert."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Debug-Modus ist CloudKit deaktiviert. TestFlight und der App Store verwenden die Produktionsumgebung: Das CloudKit-Schema muss dort über das Dashboard bereitgestellt werden, damit die Synchronisierung funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudKit is disabled in Debug. TestFlight and the App Store use the Production environment: the CloudKit schema must be deployed there via the Dashboard for sync to work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

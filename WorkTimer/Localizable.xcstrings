    "settings.reset.warning.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion löscht dauerhaft alle Ihre Daten (Arbeitstage, Urlaub, Notizen usw.) und setzt alle Einstellungen auf ihre Standardwerte zurück. Diese Aktion ist unwiderruflich und versetzt die App in einen frischen Zustand wie bei einer Neuinstallation."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion löscht dauerhaft alle Ihre Daten (Arbeitstage, Ferien, Notizen usw.) und setzt alle Einstellungen auf ihre Standardwerte zurück. Diese Aktion ist unwiderruflich und versetzt die App in den Zustand einer Neuinstallation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action will permanently delete all your data (work days, vacations, notes, etc.) and reset all settings to their default values. This action is irreversible and will restore the app to a fresh state like a new installation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement toutes vos données (jours travaillés, vacances, notes, etc.) et réinitialisera tous les paramètres à leurs valeurs par défaut. Cette action est irréversible et remettra l'application à zéro comme une nouvelle installation."
          }
        }
      }
    },
